{
  "name": "freemind",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "description": "Offline mind mapping and engineering Word document writing",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "deadcode": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.reporter=json-summary --coverage.reporter=json --coverage.reporter=text-summary",
    "size": "node scripts/size-budget.mjs",
    "features": "node scripts/check-feature-coverage.mjs",
    "build-stats": "node scripts/build-stats.mjs",
    "book": "pnpm book:epub && pnpm book:pdf",
    "book:epub": "node scripts/build-book-epub.mjs",
    "book:pdf": "node scripts/build-book-pdf.mjs",
    "stats": "pnpm test:coverage && vite build && pnpm features && pnpm build-stats",
    "gate": "tsc --noEmit && biome check . && knip && node scripts/check-feature-coverage.mjs && vitest run --coverage && vite build && node scripts/size-budget.mjs",
    "i18n:blindspot": "node scripts/i18n-blindspot.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@xyflow/react": "^12.11.0",
    "d3-hierarchy": "^3.1.2",
    "docx": "^9.9.0",
    "fast-xml-parser": "^4.5.1",
    "fflate": "^0.8.2",
    "idb": "^8.0.3",
    "marked": "^18.0.5",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^25.9.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "2.1.9",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "knip": "^6.16.1",
    "typescript": "^5.7.2",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.8",
    "workbox-window": "^7.4.1"
  }
}
