{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreeMind",
  "version": "0.1.3",
  "identifier": "com.luckyspro.freemind",
  "build": {
    "beforeDevCommand": "pnpm dev --host 127.0.0.1 --port 1437 --strictPort",
    "devUrl": "http://127.0.0.1:1437",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FreeMind",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "离线导图与工程文档写作",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "M&J Group",
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCOUFENkMzNDI5MzNBNDQKUldSRU9wTkN3OWFhNnkrVTB2NkVBbWhYTklNaXNCNS94MldXSDJvSW1GcTdXMHlkdlJtbFJTK0oK",
      "endpoints": ["https://github.com/luckySpro/freemind/releases/latest/download/latest.json"]
    }
  }
}
